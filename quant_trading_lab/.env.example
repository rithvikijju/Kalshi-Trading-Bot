# Copy this file to .env and fill what you have. Missing keys → that provider is skipped.
# DO NOT commit .env. The notebooks load this via python-dotenv.

# === Equities / ETFs ===
POLYGON_API_KEY=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

# === Futures / institutional ===
DATABENTO_API_KEY=

# === Macro ===
FRED_API_KEY=

# === Event / prediction markets ===
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
# Alternative: paste the PEM directly (less safe; prefer the file path)
KALSHI_PRIVATE_KEY=

# === Crypto exchanges ===
HYPERLIQUID_WALLET_ADDRESS=
HYPERLIQUID_PRIVATE_KEY=
BINANCE_API_KEY=
BINANCE_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# === LLM (for later NLP layer only — not used at MVP) ===
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# === Storage ===
# Default is local SQLite at ./data/lab.sqlite. Override to Postgres if desired.
DATABASE_URL=sqlite:///./data/lab.sqlite

# === Alerts ===
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# === Hard safety locks — see RISK_POLICY.md ===
# Default = paper trading only. To enable live, BOTH must be exactly "true".
LIVE_TRADING_ENABLED=false
I_UNDERSTAND_REAL_MONEY_RISK=false
